# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/repodocsai
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/repodocsai?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/repodocsai"

# Optional: Override database name from URI
# DATABASE_NAME="repodocsai"
